{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "busylittlepixels",
  "account_id": "12af8a34e16014e92c54cc2270121a72",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "busylittlepixels"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TURNSTILE_HOSTNAMES": "busylittlepixels.com",
    "CONTACT_FROM_EMAIL": "Busy Little Pixels <hello@busylittlepixels.com>"
  }
}
